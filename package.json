{
  "name": "9rtm.dev",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "preview:cf": "pnpm run build && wrangler dev",
    "preview:ci": "wrangler dev --ip 127.0.0.1 --port 4173",
    "test": "vitest run",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "media:upload": "node scripts/media-upload.ts",
    "media:verify": "node scripts/media-verify.ts",
    "lighthouse": "lhci collect --config=./lighthouserc.cjs && node scripts/write-lighthouse-summary.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "db:migrate": "wrangler d1 migrations apply 9rtm-dev-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply 9rtm-dev-db --remote"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "0.15.1",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/sveltekit": "^10.6.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/animejs": "^3.1.13",
    "@types/node": "^25.0.3",
    "@types/unist": "3.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "mdsvex": "^0.12.8",
    "parse5": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "remark-parse": "^11.0.0",
    "storybook": "^10.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unified": "^11.0.5",
    "vite": "^8.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "hast-util-to-html>mdast-util-to-hast": "^13.2.1",
      "@rollup/pluginutils>rollup": "^4.68.0",
      "@rollup/pluginutils>picomatch": "^4.0.7",
      "sass>immutable": "^5.1.9",
      "satori>fflate": "0.7.5",
      "@shuding/opentype.js>fflate": "^0.7.5",
      "@tailwindcss/node>source-map-js": "^1.2.2",
      "micromatch>picomatch": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.7"
    }
  },
  "dependencies": {
    "@fontsource/m-plus-1": "^5.2.8",
    "@lucide/svelte": "^0.525.0",
    "@threlte/core": "^8.1.3",
    "@threlte/extras": "^9.4.2",
    "@types/react": "^19.2.7",
    "@types/three": "^0.178.1",
    "animejs": "^4.1.2",
    "bits-ui": "^2.16.3",
    "date-fns": "^4.1.0",
    "feed": "^5.2.0",
    "mode-watcher": "^1.1.0",
    "pino": "^10.3.0",
    "postprocessing": "^6.38.2",
    "react": "^19.2.3",
    "rehype-slug": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "shiki": "^3.23.0",
    "three": "^0.178.0",
    "undici": "7.30.2",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
